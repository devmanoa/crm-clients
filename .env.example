VITE_API_URL=http://localhost:3004
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=konitys
VITE_KEYCLOAK_CLIENT_ID=crm-clients
VITE_PLATEFORM_URL=https://plateform.konitys.fr
VITE_CRM_URL=https://crm.konitys.fr
VITE_CRM_API_URL=https://crm.konitys.fr/api-v1

# Auth — dev only. Never set this to true in a production build:
# it bypasses Keycloak entirely and fakes an admin session.
VITE_DISABLE_AUTH=false
